# RyCitas en un servidor con Caddy propio (docker-compose.compartido.yml).
# Copiar a /etc/caddy/sites.d/80-rycitas.caddy, validar y recargar (no corta los demás sitios):
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Certificados: automáticos por host (Let's Encrypt), como los demás sitios del servidor.
# Cada negocio nuevo con subdominio propio se agrega a la lista del segundo bloque.

(rycitas_comun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Django toma la IP del visitante de CF-Connecting-IP (límites por IP). Si la petición no viene de Cloudflare,
	# alguien entró directo a la IP del servidor y pudo inventar ese encabezado: se reemplaza por su IP real.
	@rycitas_sin_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @rycitas_sin_cloudflare CF-Connecting-IP {remote_host}
}

# Plataforma: la app web, su API, el panel, el admin y la política de privacidad.
rycitas.ryjec.com {
	import rycitas_comun
	@django path /api/* /cliente/* /panel /panel/* /admin /admin/* /static/* /privacidad /privacidad/* /salud/ /webhooks/* /c/*
	handle @django {
		reverse_proxy 127.0.0.1:18100
	}
	handle {
		header Content-Security-Policy "frame-ancestors 'none'"
		header X-Content-Type-Options nosniff
		root * /opt/rycitas/deploy/app_web
		try_files {path} /index.html
		file_server
	}
}

# Sitios de los negocios.
glowclinic.ryjec.com, sonrisawari.ryjec.com {
	import rycitas_comun
	handle_path /media/* {
		header X-Content-Type-Options nosniff
		root * /opt/rycitas/deploy/media
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:18100
	}
}
