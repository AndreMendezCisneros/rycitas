# Copiar a deploy/.env y completar. deploy/.env nunca va al repositorio.

# Generar con: openssl rand -base64 48
DJANGO_SECRET_KEY=
JWT_SECRET=

# Cada negocio vive en <slug>.<PLATAFORMA_DOMINIO>; la app, la API y el panel en <APP_SUBDOMINIO>.<PLATAFORMA_DOMINIO>.
PLATAFORMA_DOMINIO=ryjec.com
APP_SUBDOMINIO=rycitas
CONFIAR_CLOUDFLARE=1
MEDIA_ROOT=/media

# Solo si el servidor ya tiene su propio Caddy en 80/443 (ver README, «Servidor compartido»):
# COMPOSE_FILE=docker-compose.yml:docker-compose.compartido.yml
# WEB_PUERTO_LOCAL=18100

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=denticita
POSTGRES_USER=denticita
POSTGRES_PASSWORD=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Opcional: purga de caché (token con permiso Cache Purge), analítica sin cookies y consulta de colegiatura
CLOUDFLARE_ZONA=
CLOUDFLARE_TOKEN_CACHE=
CLOUDFLARE_ANALYTICS_TOKEN=
COLEGIATURA_CONSULTA_URL=

# Por defecto el doctor confirma desde su propio WhatsApp (sin API de Meta y sin costo).
# Con 1 vuelve la verificación por código: requiere la API de WhatsApp Cloud y las tres variables siguientes.
VERIFICACION_WHATSAPP=0
# WhatsApp Cloud API (Meta). Número solo con dígitos: 51987654321
WHATSAPP_NUMERO_PLATAFORMA=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Firebase: colocar la cuenta de servicio en deploy/secretos/firebase.json
FIREBASE_PROJECT_ID=
FIREBASE_CREDENCIALES=/secretos/firebase.json

# Correo: códigos de acceso de la app de clientes. Obligatorio con VERIFICAR_CLIENTES=1 (check --deploy lo exige).
VERIFICAR_CLIENTES=1
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=RyCitas <no-responder@ryjec.com>

# Límites por IP y por hora (los valores por defecto sirven para empezar)
MAX_INTENTOS_IP_HORA=5
MAX_EVENTOS_IP_HORA=120
PANEL_MAX_INTENTOS_IP_HORA=20

# Opcional: errores en el plan gratuito de Sentry (sin datos personales: ver denticita/errores.py)
SENTRY_DSN=
SENTRY_ENTORNO=produccion
LOG_LEVEL=INFO

# Respaldos (deploy/respaldar.sh). Sin esta clave no se recupera ninguna copia: guárdala fuera del servidor.
RESPALDO_CLAVE=
RCLONE_DESTINO=r2:denticita-respaldos

# Adelantos (Yape, Plin, efectivo, transferencia) con verificación manual. Desarrollados y APAGADOS.
# Con 1, el panel deja activarlos por negocio; con 0 sus rutas responden 404 y ni la app ni el sitio los muestran.
PAGOS_ADELANTADOS=0

# Titular de los datos (aparece en /privacidad/; check --deploy los exige). Canal para los derechos ARCO.
TITULAR_NOMBRE=
TITULAR_DOCUMENTO=
TITULAR_DOMICILIO=
TITULAR_CORREO=

# Chequeos de despliegue omitidos a propósito, separados por comas. Vacío en un despliegue completo.
# denticita.E006: falta el titular · denticita.E007: falta Turnstile (las reservas web se rechazan)
CHEQUEOS_OMITIDOS=
