# Certificado de origen de Cloudflare (gratuito, 15 años, cubre *.dominio) en ./certs.
# Se usa en lugar de certificados automáticos: un comodín de Let's Encrypt exige el reto DNS, y la
# imagen oficial de Caddy no trae el módulo de Cloudflare. Ver docs/ANALISIS.md, hallazgo 9.
(comun) {
	tls /certs/origen.pem /certs/origen.key
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
}

# Host de la plataforma (APP_SUBDOMINIO, en producción rycitas.ryjec.com): la app compilada para web (respaldo
# para quien no tenga Android), su API, el panel, el admin y la política de privacidad que enlaza la app.
{$APP_SUBDOMINIO}.{$PLATAFORMA_DOMINIO} {
	import comun
	@django path /api/* /cliente/* /panel /panel/* /admin /admin/* /static/* /privacidad /privacidad/* /salud/ /webhooks/* /c/*
	handle @django {
		reverse_proxy web:8000
	}
	handle {
		header Content-Security-Policy "frame-ancestors 'none'"
		header X-Content-Type-Options nosniff
		root * /app_web
		try_files {path} /index.html
		file_server
	}
}

# Sitios de consultorios, panel y webhook.
{$PLATAFORMA_DOMINIO}, *.{$PLATAFORMA_DOMINIO} {
	import comun
	handle_path /media/* {
		header X-Content-Type-Options nosniff
		root * /media
		file_server
	}
	handle {
		reverse_proxy web:8000
	}
}
